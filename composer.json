{
    "name": "wp-privacy/wp-api-privacy",
    "type": "wordpress-plugin",
    "description": "Strips potentially identifying information from outbound requests to the WordPress.org API",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "wordpress",
        "plugin",
        "privacy"
    ],
    "authors": [
        {
            "name": "Duane Storey",
            "email": "duanestorey@gmail.com"
        }
    ],
    "require": {
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "brain/monkey": "^2.6",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "*",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "scripts": {
        "test": [
            "@php ./vendor/phpunit/phpunit/phpunit"
        ],
        "lint": [
            "@php ./vendor/php-parallel-lint/php-parallel-lint/parallel-lint . -e php --show-deprecated --exclude vendor --exclude node_modules --exclude .git"
        ],
        "check-cs": [
            "@php ./vendor/bin/phpcs"
        ],
        "fix-cs": [
            "@php ./vendor/bin/phpcbf"
        ],
        "phpstan": [
            "@php ./vendor/bin/phpstan analyse --memory-limit=2048M"
        ],
        "phpunit": [
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WP_Privacy\\WP_API_Privacy\\Tests\\": "tests/"
        }
    }
}
